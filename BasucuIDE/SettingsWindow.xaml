<Window x:Class="mdaiAgent.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:mdaiAgent"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{local:Loc Key=SettingsTitle}" Height="820" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="#0f0f1a"
        Foreground="#e0e0ff"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>

        <SolidColorBrush x:Key="DarkBackground"      Color="#0f0f1a"/>

        <SolidColorBrush x:Key="DarkPanelBackground" Color="#1a1a2e"/>

        <SolidColorBrush x:Key="DarkBorder"          Color="#3f3f6f"/>

        <SolidColorBrush x:Key="DarkText"            Color="#e0e0ff"/>

        <SolidColorBrush x:Key="DarkAccent"          Color="#8b5cf6"/>

        <SolidColorBrush x:Key="DarkAccentLight"     Color="#a78bfa"/>

        <SolidColorBrush x:Key="CardBackground"      Color="#1e1e35"/>



        <LinearGradientBrush x:Key="SettingsBackgroundGradient" StartPoint="0,0" EndPoint="1,1">

            <GradientStop Color="#141625" Offset="0"/>

            <GradientStop Color="#0b0d13" Offset="1"/>

        </LinearGradientBrush>



        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">

            <GradientStop Color="#8b5cf6" Offset="0"/>

            <GradientStop Color="#6366f1" Offset="1"/>

        </LinearGradientBrush>



        <!-- ScrollBar style -->

        <Style TargetType="ScrollBar">

            <Setter Property="Width" Value="8"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ScrollBar">

                        <Grid Background="Transparent">

                            <Track x:Name="PART_Track" IsDirectionReversed="True">

                                <Track.Thumb>

                                    <Thumb>

                                        <Thumb.Template>

                                            <ControlTemplate TargetType="Thumb">

                                                <Border Background="#4a4a7a" CornerRadius="4" Margin="2"/>

                                            </ControlTemplate>

                                        </Thumb.Template>

                                    </Thumb>

                                </Track.Thumb>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- TextBox style -->

        <Style TargetType="TextBox">

            <Setter Property="Background" Value="#12122a"/>

            <Setter Property="Foreground" Value="#e0e0ff"/>

            <Setter Property="BorderBrush" Value="#3f3f6f"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Padding" Value="10,8"/>

            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>

            <Setter Property="FontSize" Value="13"/>

            <Setter Property="CaretBrush" Value="#a78bfa"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="Bd" Background="{TemplateBinding Background}"

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}"

                                Padding="{TemplateBinding Padding}" CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsFocused" Value="True">

                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8b5cf6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- PasswordBox style -->

        <Style TargetType="PasswordBox">

            <Setter Property="Background" Value="#12122a"/>

            <Setter Property="Foreground" Value="#e0e0ff"/>

            <Setter Property="BorderBrush" Value="#3f3f6f"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Padding" Value="10,8"/>

            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>

            <Setter Property="FontSize" Value="13"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="PasswordBox">

                        <Border x:Name="Bd" Background="{TemplateBinding Background}"

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}"

                                Padding="{TemplateBinding Padding}" CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsFocused" Value="True">

                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8b5cf6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Button style -->

        <Style TargetType="Button">

            <Setter Property="Background" Value="#1e1e35"/>

            <Setter Property="Foreground" Value="#e0e0ff"/>

            <Setter Property="BorderBrush" Value="#3f3f6f"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Padding" Value="18,10"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Bd" Background="{TemplateBinding Background}"

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}"

                                Padding="{TemplateBinding Padding}" CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="Bd" Property="Background" Value="#2a2a4a"/>

                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8b5cf6"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="Bd" Property="Background" Value="#7c3aed"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- CheckBox style -->

        <Style TargetType="CheckBox">

            <Setter Property="Foreground" Value="#e0e0ff"/>

            <Setter Property="Margin" Value="0,4,0,4"/>

        </Style>



        <Style x:Key="LanguageSegmentStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="#8b5cf6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="#35275e"/>
                                <Setter Property="Foreground" Value="#f5f3ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label style -->

        <Style TargetType="Label">

            <Setter Property="Foreground" Value="#a0a0c0"/>

            <Setter Property="Margin" Value="0,10,0,4"/>

            <Setter Property="FontSize" Value="12"/>

            <Setter Property="Padding" Value="0"/>

        </Style>

    </Window.Resources>



    <Border Background="{StaticResource SettingsBackgroundGradient}" Padding="24">

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel>



                <!-- Header -->

                <Grid Margin="0,0,0,24">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <Border Width="46" Height="46" CornerRadius="23" Margin="0,0,14,0">

                        <Border.Background>

                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                                <GradientStop Color="#a78bfa" Offset="0"/>

                                <GradientStop Color="#6366f1" Offset="1"/>

                            </LinearGradientBrush>

                        </Border.Background>

                        <TextBlock Text="⚙" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">

                        <TextBlock x:Name="txtSettingsTitle" Text="{local:Loc Key=Ayarlar}" FontSize="22" FontWeight="Bold" Foreground="#e0e0ff"/>

                        <TextBlock x:Name="txtSettingsSubtitle" Text="{local:Loc Key=SettingsSubtitle}" FontSize="12" Foreground="#6b6b9a" Margin="0,4,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">

                        <TextBlock x:Name="txtLanguageLabel" Text="{local:Loc Key=UygulamaDiliAppLanguage}" Foreground="#a0a0c0" FontSize="10" Margin="0,0,0,5" HorizontalAlignment="Right"/>

                        <Border Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="9" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="rbLanguageTurkish" GroupName="AppLanguage" Content="{local:Loc Key=LanguageTurkish}" Tag="tr" Style="{StaticResource LanguageSegmentStyle}"/>
                                <RadioButton x:Name="rbLanguageEnglish" GroupName="AppLanguage" Content="{local:Loc Key=LanguageEnglish}" Tag="en" Style="{StaticResource LanguageSegmentStyle}"/>
                                <RadioButton x:Name="rbLanguageChinese" GroupName="AppLanguage" Content="{local:Loc Key=LanguageChinese}" Tag="zh" Style="{StaticResource LanguageSegmentStyle}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                </Grid>



                <!-- ===== YAPAY ZEKA BAĞLANTISI ===== -->

                <TextBlock Text="{local:Loc Key=AiConnection}" FontSize="14" FontWeight="SemiBold" Foreground="#a78bfa" Margin="0,0,0,12"/>



                <!-- 3 Provider Kartı -->

                <Grid Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="8"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="8"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>



                    <!-- Kart 1: API Servisi -->

                    <Border x:Name="cardApiService" Grid.Column="0"

                            Background="#1e1e35" CornerRadius="12"

                            BorderBrush="#3f3f6f" BorderThickness="1.5"

                            Padding="14,16" Cursor="Hand"

                            MouseLeftButtonUp="CardApiService_Click">

                        <StackPanel>

                            <TextBlock Text="🌐" FontSize="26" Margin="0,0,0,8"/>

                            <TextBlock Text="API Service" FontSize="13" FontWeight="SemiBold" Foreground="#e0e0ff"/>

                            <TextBlock Text="OpenRouter, DeepSeek&#x0a;Nvidia NIM and compatible APIs" FontSize="11" Foreground="#6b6b9a" TextWrapping="Wrap" Margin="0,4,0,0"/>

                        </StackPanel>

                    </Border>



                    <!-- Kart 2: Yerel Model -->

                    <Border x:Name="cardLocalModel" Grid.Column="2"

                            Background="#1e1e35" CornerRadius="12"

                            BorderBrush="#3f3f6f" BorderThickness="1.5"

                            Padding="14,16" Cursor="Hand"

                            MouseLeftButtonUp="CardLocalModel_Click">

                        <StackPanel>

                            <TextBlock Text="🏠" FontSize="26" Margin="0,0,0,8"/>

                            <TextBlock Text="Local Model" FontSize="13" FontWeight="SemiBold" Foreground="#e0e0ff"/>

                            <TextBlock Text="Ollama, LM Studio&#x0a;No internet required" FontSize="11" Foreground="#6b6b9a" TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <!-- Canlı durum göstergesi -->

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">

                                <Ellipse x:Name="ollamaStatusDot" Width="8" Height="8" Fill="#4a4a6a" VerticalAlignment="Center"/>

                                <TextBlock x:Name="ollamaStatusText" Text="Kontrol ediliyor..." FontSize="10" Foreground="#6b6b9a" Margin="6,0,0,0" VerticalAlignment="Center"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>



                    <!-- Kart 3: Büyük Modeller -->

                    <Border x:Name="cardBigModels" Grid.Column="4"

                            Background="#1e1e35" CornerRadius="12"

                            BorderBrush="#3f3f6f" BorderThickness="1.5"

                            Padding="14,16" Cursor="Hand"

                            MouseLeftButtonUp="CardBigModels_Click">

                        <StackPanel>

                            <TextBlock Text="✨" FontSize="26" Margin="0,0,0,8"/>

                            <TextBlock Text="Large Models" FontSize="13" FontWeight="SemiBold" Foreground="#e0e0ff"/>

                            <TextBlock Text="Claude, Gemini, GPT-4&#x0a;Official API integrations" FontSize="11" Foreground="#6b6b9a" TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <!-- Marka etiketleri -->

                            <WrapPanel Margin="0,10,0,0">

                                <Border Background="#2a1a3a" CornerRadius="4" Padding="5,2" Margin="0,0,4,4">

                                    <TextBlock Text="Anthropic" FontSize="9" Foreground="#c084fc"/>

                                </Border>

                                <Border Background="#1a2a3a" CornerRadius="4" Padding="5,2" Margin="0,0,4,4">

                                    <TextBlock Text="Google" FontSize="9" Foreground="#60a5fa"/>

                                </Border>

                                <Border Background="#1a2a1a" CornerRadius="4" Padding="5,2" Margin="0,0,4,4">
                                    <TextBlock Text="Diğerleri" FontSize="9" Foreground="#34d399"/>
                                </Border>

                            </WrapPanel>

                        </StackPanel>

                    </Border>

                </Grid>



                <!-- Panel 1: API Servisi Ayarları -->

                <Border x:Name="panelApiService" Background="#191929"

                        CornerRadius="12" BorderBrush="#8b5cf6" BorderThickness="1"

                        Padding="18" Margin="0,0,0,16" Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock Text="{local:Loc Key=ApiServiceSettings}" FontSize="13" FontWeight="SemiBold" Foreground="#a78bfa" Margin="0,0,0,14"/>

                        <Label Content="API Base URL"/>

                        <TextBox x:Name="txtBaseUrl"/>

                        <Label Content="{local:Loc Key=APIAnahtari}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="pbApiKey" PasswordChar="●" Grid.Column="0"/>
                            <TextBox x:Name="txtApiKey" Visibility="Collapsed" Grid.Column="0"/>
                            <Button x:Name="btnToggleMainKey" Content="👁️" Grid.Column="1" Width="36" Margin="6,0,0,0" Padding="0" Click="BtnToggleKey_Click" ToolTip="Göster / Gizle" Background="#2a2a4a" Foreground="#ffffff"/>
                        </Grid>

                        <Label Content="{local:Loc Key=ModelAdi}"/>

                        <TextBox x:Name="txtModel"/>

                        <Label Content="{local:Loc Key=APIZamanAsimiSaniye}"/>

                        <TextBox x:Name="txtApiTimeoutSeconds"/>

                        <!-- Test butonu -->

                        <Button x:Name="btnTestApiService" Content="{local:Loc Key=TestConnection}"

                                Margin="0,16,0,0" HorizontalAlignment="Left"

                                Click="BtnTestApiService_Click"/>

                        <TextBlock x:Name="txtApiTestResult" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>

                    </StackPanel>

                </Border>



                <!-- Panel 2: Yerel Model Ayarları -->

                <Border x:Name="panelLocalModel" Background="#191929"

                        CornerRadius="12" BorderBrush="#8b5cf6" BorderThickness="1"

                        Padding="18" Margin="0,0,0,16" Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock Text="{local:Loc Key=LocalModelSettings}" FontSize="13" FontWeight="SemiBold" Foreground="#a78bfa" Margin="0,0,0,14"/>

                        <Label Content="{local:Loc Key=BaseURLOllamaIcinHttpLocalhost11434V1}"/>

                        <TextBox x:Name="txtLocalBaseUrl"/>

                        <Label Content="{local:Loc Key=ModelAdi}"/>

                        <TextBox x:Name="txtLocalModel"/>

                        <!-- Test butonu -->

                        <Button x:Name="btnTestLocal" Content="{local:Loc Key=TestConnection}"

                                Margin="0,16,0,0" HorizontalAlignment="Left"

                                Click="BtnTestLocal_Click"/>

                        <TextBlock x:Name="txtLocalTestResult" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>

                    </StackPanel>

                </Border>



                <!-- Panel 3: Büyük Modeller (Alt sağlayıcı seçimi) -->

                <Border x:Name="panelBigModels" Background="#191929"

                        CornerRadius="12" BorderBrush="#8b5cf6" BorderThickness="1"

                        Padding="18" Margin="0,0,0,16" Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock Text="{local:Loc Key=SelectProvider}" FontSize="13" FontWeight="SemiBold" Foreground="#a78bfa" Margin="0,0,0,14"/>



                        <!-- Alt provider kartları -->

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="8"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="8"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>



                            <Border x:Name="subCardAnthropic" Grid.Column="0"

                                    Background="#1e1e35" CornerRadius="10"

                                    BorderBrush="#3f3f6f" BorderThickness="1.5"

                                    Padding="12,14" Cursor="Hand"

                                    MouseLeftButtonUp="SubCardAnthropic_Click">

                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock Text="🟤" FontSize="22" HorizontalAlignment="Center"/>

                                    <TextBlock Text="Anthropic" FontSize="12" FontWeight="SemiBold" Foreground="#c084fc" HorizontalAlignment="Center" Margin="0,6,0,0"/>

                                    <TextBlock Text="Claude 3.5 Sonnet" FontSize="10" Foreground="#6b6b9a" HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>



                            <Border x:Name="subCardGoogle" Grid.Column="2"

                                    Background="#1e1e35" CornerRadius="10"

                                    BorderBrush="#3f3f6f" BorderThickness="1.5"

                                    Padding="12,14" Cursor="Hand"

                                    MouseLeftButtonUp="SubCardGoogle_Click">

                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock Text="🔵" FontSize="22" HorizontalAlignment="Center"/>

                                    <TextBlock Text="Google" FontSize="12" FontWeight="SemiBold" Foreground="#60a5fa" HorizontalAlignment="Center" Margin="0,6,0,0"/>

                                    <TextBlock Text="Gemini 1.5 Pro" FontSize="10" Foreground="#6b6b9a" HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>



                            <Border x:Name="subCardOpenAI" Grid.Column="4"

                                    Background="#1e1e35" CornerRadius="10"

                                    BorderBrush="#3f3f6f" BorderThickness="1.5"

                                    Padding="12,14" Cursor="Hand"

                                    MouseLeftButtonUp="SubCardOpenAI_Click">

                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🟢" FontSize="22" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Diğer (OpenAI)" FontSize="12" FontWeight="SemiBold" Foreground="#34d399" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBlock Text="GPT, DeepSeek, Llama vb." FontSize="10" Foreground="#6b6b9a" HorizontalAlignment="Center"/>
                                </StackPanel>

                            </Border>

                        </Grid>



                        <!-- Sağlayıcı özel alanlar -->

                        <Border x:Name="bigModelFields" Visibility="Collapsed">

                            <StackPanel>

                                <Label Content="API Base URL"/>

                                <TextBox x:Name="txtBigModelBaseUrl"/>

                                <Label Content="{local:Loc Key=APIAnahtari}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="pbBigModelApiKey" PasswordChar="●" Grid.Column="0"/>
                                    <TextBox x:Name="txtBigModelApiKey" Visibility="Collapsed" Grid.Column="0"/>
                                    <Button x:Name="btnToggleBigModelKey" Content="👁️" Grid.Column="1" Width="36" Margin="6,0,0,0" Padding="0" Click="BtnToggleKey_Click" ToolTip="Göster / Gizle" Background="#2a2a4a" Foreground="#ffffff"/>
                                </Grid>

                                <Label Content="{local:Loc Key=ModelAdi}"/>

                                <TextBox x:Name="txtBigModelModel"/>

                                <Button x:Name="btnTestBigModel" Content="{local:Loc Key=TestConnection}"

                                        Margin="0,16,0,0" HorizontalAlignment="Left"

                                        Click="BtnTestBigModel_Click"/>

                                <TextBlock x:Name="txtBigModelTestResult" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>



                <Separator Background="#2a2a4a" Margin="0,8,0,20"/>



                <!-- Tavily Web Search (Provider'dan bağımsız) -->

                        <TextBlock Text="{local:Loc Key=WebAramaTavily}" FontSize="14" FontWeight="SemiBold" Foreground="#a78bfa" Margin="0,0,0,10"/>

                <Border Background="#191929" CornerRadius="10" BorderBrush="#2a2a4a" BorderThickness="1" Padding="16" Margin="0,0,0,4">

                    <StackPanel>

                        <TextBlock Text="{local:Loc Key=HangiYapayZekaModeliniKullanirsanizKullaninWebAramasiBuAPIUzerindenCalisir}" 

                                   FontSize="11" Foreground="#6b6b9a" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Label Content="{local:Loc Key=TavilyAPIAnahtari}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="pbTavilyApiKey" PasswordChar="●" Grid.Column="0"/>
                            <TextBox x:Name="txtTavilyApiKey" Visibility="Collapsed" Grid.Column="0"/>
                            <Button x:Name="btnToggleTavilyKey" Content="👁️" Grid.Column="1" Width="36" Margin="6,0,0,0" Padding="0" Click="BtnToggleKey_Click" ToolTip="Göster / Gizle" Background="#2a2a4a" Foreground="#ffffff"/>
                        </Grid>

                        <TextBlock Margin="0,6,0,0">

                            <Hyperlink NavigateUri="https://tavily.com" RequestNavigate="Hyperlink_RequestNavigate">

                                <Run Text="{local:Loc Key=GetFreeTavilyKey}" Foreground="#6366f1" FontSize="11"/>

                            </Hyperlink>

                        </TextBlock>

                    </StackPanel>

                </Border>



                <Separator Background="#2a2a4a" Margin="0,20,0,20"/>



                <!-- AI Router (Yönlendirici) -->

                <Border Background="#1a1a2e" BorderBrush="#2a2a4a" BorderThickness="1" CornerRadius="6" Padding="12">

                    <StackPanel>

                        <TextBlock Text="{local:Loc Key=AIRouterToolYonlendirici}" FontSize="14" FontWeight="SemiBold" Foreground="#a78bfa" Margin="0,0,0,10"/>

                        <TextBlock Text="{local:Loc Key=AnaModeldenOnceCalisarakSadeceGerekenAraclariSecerTokenTasarrufuSaglar}" Foreground="#9ca3af" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        

                        <!-- Üç Router Seçeneği -->
                        <StackPanel Margin="0,0,0,8">
                            <!-- 1. Seçenek: Yerel Dahili Router -->
                            <CheckBox x:Name="cbRouterUseLocalModel" Content="{local:Loc Key=YerelDahiliRouterOnerilen}"
                                      FontWeight="SemiBold" Foreground="#10b981" Margin="0,0,0,6"
                                      Checked="CbRouterUseLocalModel_Changed" Unchecked="CbRouterUseLocalModel_Changed"/>

                            <!-- Yerel Model İndirme ve Durum Paneli -->
                            <Border x:Name="pnlLocalModelDownload" Background="#1e1e2e" BorderBrush="#313244" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,2,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtLocalModelStatus" Text="{local:Loc Key=YerelRouterModelDurumuKontrolEdiliyor}" Foreground="#a6adc8" FontSize="11" FontWeight="Medium" TextWrapping="Wrap"/>
                                        <ProgressBar x:Name="pbLocalModelDownload" Height="6" Margin="0,6,10,0" Visibility="Collapsed" Maximum="100" Value="0" Background="#313244" Foreground="#10b981"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="btnInstallOllama" Content="{local:Loc Key=OllamaIndir}" Padding="10,5" Margin="0,0,5,0" Background="#3b82f6" Foreground="#ffffff" FontWeight="Bold" Click="BtnInstallOllama_Click" Visibility="Collapsed" ToolTip="{local:Loc Key=OllamaIndirTooltip}"/>
                                        <Button x:Name="btnCheckOllama" Content="🔄 Kontrol Et" Padding="10,5" Margin="0,0,5,0" Background="#4b5563" Foreground="#ffffff" FontWeight="Bold" Click="BtnCheckOllama_Click" Visibility="Collapsed" ToolTip="Ollama kurulumunu tamamladıktan sonra tekrar kontrol etmek için tıklayın."/>
                                        <Button x:Name="btnSelectLocalGguf" Content="{local:Loc Key=GgufDosyasiSec}" Padding="10,5" Margin="0,0,5,0" Background="#8b5cf6" Foreground="#ffffff" FontWeight="Bold" Click="BtnSelectLocalGguf_Click" Visibility="Collapsed" ToolTip="{local:Loc Key=GgufDosyasiSecTooltip}"/>
                                        <Button x:Name="btnDownloadLocalModel" Content="{local:Loc Key=YengiRouterIndirUcretsiz}" Padding="10,5" Background="#10b981" Foreground="#ffffff" FontWeight="Bold" Click="BtnDownloadLocalModel_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 2 ve 3. Seçenekler -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <CheckBox x:Name="cbRouterEnabled" Content="{local:Loc Key=AIRouterKullanOnerilen}"
                                          Checked="CbRouterEnabled_Changed" Unchecked="CbRouterEnabled_Changed"/>

                                <CheckBox x:Name="cbRouterUseMainModel" Content="{local:Loc Key=AnaModeliKullan}"
                                          Margin="16,0,0,0"
                                          Checked="CbRouterUseMainModel_Changed" Unchecked="CbRouterUseMainModel_Changed"/>
                            </StackPanel>
                        </StackPanel>

                        

                        <Label Content="{local:Loc Key=RouterBaseURL}"/>

                        <TextBox x:Name="txtRouterBaseUrl"/>



                        <Label Content="{local:Loc Key=RouterModel}"/>

                        <TextBox x:Name="txtRouterModel"/>

                        

                        <Label Content="{local:Loc Key=RouterAPIAnahtari}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="pbRouterApiKey" PasswordChar="●" Grid.Column="0"/>
                            <TextBox x:Name="txtRouterApiKey" Visibility="Collapsed" Grid.Column="0"/>
                            <Button x:Name="btnToggleRouterKey" Content="👁️" Grid.Column="1" Width="36" Margin="6,0,0,0" Padding="0" Click="BtnToggleKey_Click" ToolTip="Göster / Gizle" Background="#2a2a4a" Foreground="#ffffff"/>
                        </Grid>



                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">

                            <StackPanel>

                                <Label Content="{local:Loc Key=GuvenEsigi0010}"/>

                                <TextBox x:Name="txtRouterConfidence" Width="80" HorizontalAlignment="Left"/>

                            </StackPanel>

                            <Button x:Name="btnRouterBlacklist" Content="{local:Loc Key=KaraListe}" Width="120" Height="40" Margin="20,15,0,0" HorizontalAlignment="Left" Background="#2a2a4a" Foreground="#a78bfa" Click="BtnRouterBlacklist_Click"/>

                        </StackPanel>

                    </StackPanel>

                </Border>



                <Separator Background="#2a2a4a" Margin="0,20,0,20"/>



                <!-- Asistan Kişiselleştirme -->

                <TextBlock Text="{local:Loc Key=AsistanKisisellestirmeIstegeBagli}" FontSize="14" FontWeight="SemiBold" Foreground="#a78bfa" Margin="0,0,0,6"/>

                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.75" FontSize="11">

                    <Run Text="{local:Loc Key=AsistanKisisellestirmeAciklama}"/>

                    <LineBreak/>

                    <Run Foreground="#6ee7b7" Text="{local:Loc Key=AsistanKisisellestirmeOrnek}"/>

                </TextBlock>

                <TextBox x:Name="txtSystemPrompt" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"

                         Tag="{local:Loc Key=AsistanKisisellestirmeYerTutucu}"/>



                <Separator Background="#2a2a4a" Margin="0,20,0,20"/>



                <!-- Ajan + Otomatik Kayıt -->

                <TextBlock Text="{local:Loc Key=AjanModulleri}" FontSize="14" FontWeight="SemiBold" Foreground="#a78bfa" Margin="0,0,0,10"/>

                <CheckBox x:Name="cbQaAgentEnabled" Content="{local:Loc Key=QADenetimAjaniKodIncelemesi}"/>

                <CheckBox x:Name="cbUiAgentEnabled" Content="{local:Loc Key=UIAmpRefaktorAjani}"/>



                <Separator Background="#2a2a4a" Margin="0,20,0,20"/>



                <TextBlock Text="{local:Loc Key=OtomatikKaydetmeBaslik}" FontSize="14" FontWeight="SemiBold" Foreground="#a78bfa" Margin="0,0,0,10"/>

                <CheckBox x:Name="cbAutoSaveEnabled" Content="{local:Loc Key=EnableAutoSave}"/>

                <Label Content="{local:Loc Key=KaydetmeAraligiSaniye}"/>

                <TextBox x:Name="txtAutoSaveIntervalSeconds" Width="120" HorizontalAlignment="Left"/>

                <Separator Background="#2a2a4a" Margin="0,20,0,20"/>

                <!-- Gizlilik & Telemetri -->
                <TextBlock Text="{local:Loc Key=GizlilikVeTelemetri}" FontSize="14" FontWeight="SemiBold" Foreground="#a78bfa" Margin="0,0,0,10"/>
                <CheckBox x:Name="cbTelemetryEnabled" Content="{local:Loc Key=AnonimKullanimIstatistikleriniPaylas}" IsChecked="True"/>
                <TextBlock Text="{local:Loc Key=TelemetriAciklama}" Foreground="#6b6b9a" FontSize="11" TextWrapping="Wrap" Margin="24,2,0,0"/>

                <Separator Background="#2a2a4a" Margin="0,24,0,24"/>



                <!-- Kaydet / İptal -->

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <Button x:Name="btnSettingsCancel" Content="{local:Loc Key=Cancel}" Click="BtnCancel_Click" Margin="0,0,8,0"/>

                    <Button x:Name="btnSettingsSave" Content="✓  Kaydet" Click="BtnSave_Click" Margin="0">

                        <Button.Background>

                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                                <GradientStop Color="#8b5cf6" Offset="0"/>

                                <GradientStop Color="#6366f1" Offset="1"/>

                            </LinearGradientBrush>

                        </Button.Background>

                        <Button.Foreground>White</Button.Foreground>

                        <Button.BorderBrush>Transparent</Button.BorderBrush>

                    </Button>

                </StackPanel>



            </StackPanel>

        </ScrollViewer>

    </Border>

</Window>

