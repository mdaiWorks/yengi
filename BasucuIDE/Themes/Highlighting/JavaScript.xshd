<?xml version="1.0"?>
<SyntaxDefinition name="JavaScript (mdaiAgent)" extensions=".js;.jsx;.ts;.tsx;.mjs;.cjs" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

    <!-- VS Code Dark+ renk paleti -->
    <Color name="Comment"    foreground="#6A9955" />
    <Color name="String"     foreground="#CE9178" />
    <Color name="Keyword"    foreground="#569CD6" fontWeight="bold" />
    <Color name="Number"     foreground="#B5CEA8" />
    <Color name="Function"   foreground="#DCDCAA" />
    <Color name="Operator"   foreground="#D4D4D4" />
    <Color name="BuiltIn"    foreground="#4EC9B0" />

    <RuleSet>
        <!-- Tek satır yorum -->
        <Span color="Comment">
            <Begin>//</Begin>
        </Span>
        <!-- Çok satırlı yorum -->
        <Span color="Comment" multiline="true">
            <Begin>/\*</Begin>
            <End>\*/</End>
        </Span>

        <!-- Çift tırnak string -->
        <Span color="String" multiline="true">
            <Begin>"</Begin>
            <End>"</End>
            <RuleSet>
                <Span><Begin>\\</Begin><End>.</End></Span>
            </RuleSet>
        </Span>
        <!-- Tek tırnak string -->
        <Span color="String" multiline="true">
            <Begin>'</Begin>
            <End>'</End>
            <RuleSet>
                <Span><Begin>\\</Begin><End>.</End></Span>
            </RuleSet>
        </Span>
        <!-- Template literal -->
        <Span color="String" multiline="true">
            <Begin>`</Begin>
            <End>`</End>
        </Span>

        <Keywords color="Keyword">
            <Word>async</Word>
            <Word>await</Word>
            <Word>break</Word>
            <Word>case</Word>
            <Word>catch</Word>
            <Word>class</Word>
            <Word>const</Word>
            <Word>continue</Word>
            <Word>debugger</Word>
            <Word>default</Word>
            <Word>delete</Word>
            <Word>do</Word>
            <Word>else</Word>
            <Word>export</Word>
            <Word>extends</Word>
            <Word>false</Word>
            <Word>finally</Word>
            <Word>for</Word>
            <Word>from</Word>
            <Word>function</Word>
            <Word>if</Word>
            <Word>import</Word>
            <Word>in</Word>
            <Word>instanceof</Word>
            <Word>interface</Word>
            <Word>let</Word>
            <Word>new</Word>
            <Word>null</Word>
            <Word>of</Word>
            <Word>return</Word>
            <Word>static</Word>
            <Word>super</Word>
            <Word>switch</Word>
            <Word>this</Word>
            <Word>throw</Word>
            <Word>true</Word>
            <Word>try</Word>
            <Word>typeof</Word>
            <Word>undefined</Word>
            <Word>var</Word>
            <Word>void</Word>
            <Word>while</Word>
            <Word>with</Word>
            <Word>yield</Word>
        </Keywords>

        <Keywords color="BuiltIn">
            <Word>Array</Word>
            <Word>Boolean</Word>
            <Word>console</Word>
            <Word>Date</Word>
            <Word>document</Word>
            <Word>Error</Word>
            <Word>Event</Word>
            <Word>Function</Word>
            <Word>JSON</Word>
            <Word>Map</Word>
            <Word>Math</Word>
            <Word>Number</Word>
            <Word>Object</Word>
            <Word>Promise</Word>
            <Word>RegExp</Word>
            <Word>Set</Word>
            <Word>String</Word>
            <Word>Symbol</Word>
            <Word>window</Word>
            <Word>document</Word>
            <Word>module</Word>
            <Word>require</Word>
        </Keywords>

        <!-- Method/Function calls (word followed by parenthesis) 
             Without lookahead to be absolutely safe -->
        <Rule color="Function">[\w]+\(</Rule>

        <!-- Numbers -->
        <Rule color="Number">0x[\da-fA-F]+</Rule>
        <Rule color="Number">[\d]+\.[\d]+</Rule>
        <Rule color="Number">[\d]+</Rule>

        <Rule color="Operator">[+\-*/=&lt;&gt;!|&amp;^~%?:,.;]</Rule>
    </RuleSet>
</SyntaxDefinition>
