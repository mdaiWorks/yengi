<Window x:Class="mdaiAgent.RouterBlacklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Router Blacklist" Height="450" Width="350"
        Background="#0f0f17" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitle" Grid.Row="0" Text="Router Blacklist" FontSize="18" FontWeight="SemiBold" Foreground="#a78bfa" Margin="0,0,0,5"/>
        <TextBlock x:Name="txtSubtitle" Grid.Row="1" Text="Selected tools will be hidden from the router and cannot be used by it." TextWrapping="Wrap" Foreground="#9ca3af" FontSize="12" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icTools">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" 
                                  IsChecked="{Binding IsBlacklisted}" 
                                  Foreground="#e0e0ff" 
                                  Margin="0,5,0,5"
                                  ToolTip="{Binding Description}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button x:Name="btnSave" Grid.Row="3" Content="Save and Close" Height="30" Margin="0,15,0,0" Background="#a78bfa" Foreground="White" FontWeight="Bold" Click="BtnSave_Click"/>
    </Grid>
</Window>
