<Window x:Class="mdaiAgent.RagSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc Key=RAGButunselProjeZekasiAyarlari}"
        Width="520" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False" xmlns:local="clr-namespace:mdaiAgent">

    <Window.Resources>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1c2128"/>
            <Setter Property="Foreground" Value="#cdd9e5"/>
            <Setter Property="BorderBrush" Value="#373e47"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="CaretBrush" Value="#58a6ff"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#58a6ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#1c2128"/>
            <Setter Property="Foreground" Value="#cdd9e5"/>
            <Setter Property="BorderBrush" Value="#373e47"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="CaretBrush" Value="#58a6ff"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#58a6ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SaveButton" TargetType="Button">
            <Setter Property="Background" Value="#238636"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2ea043"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1a7f37"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="Background" Value="#21262d"/>
            <Setter Property="Foreground" Value="#cdd9e5"/>
            <Setter Property="BorderBrush" Value="#373e47"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DisableButton" TargetType="Button">
            <Setter Property="Background" Value="#3d1010"/>
            <Setter Property="Foreground" Value="#f85149"/>
            <Setter Property="BorderBrush" Value="#6e1010"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5a1515"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0d1117"
            BorderBrush="#373e47"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="6" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <Border Grid.Row="0" Background="#161b22" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid Margin="20,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧠" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtTitle" Text="{local:Loc Key=RAGButunselProjeZekasi}"
                                       FontSize="14" FontWeight="SemiBold" Foreground="#cdd9e5"/>
                            <TextBlock x:Name="txtSubtitle"
                                       Text="{local:Loc Key=ProjeniziAIATamAnlatmakIcinBirEmbeddingAPIGirin}"
                                       FontSize="11" Foreground="#8b949e"/>
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Content="✕" Width="28" Height="28"
                            Style="{StaticResource CancelButton}"
                            Click="BtnClose_Click" FontSize="12" Padding="0"/>
                </Grid>
            </Border>

            <!-- İçerik -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,16">

                    <!-- Hızlı Şablon Kartları -->
                    <TextBlock x:Name="txtQuickTemplateTitle" Text="{local:Loc Key=HIZLISABLONSEC}" Foreground="#8b949e"
                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <!-- Bulut API Kartı -->
                    <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,0,0,6" Cursor="Hand"
                            MouseLeftButtonDown="CardCloud_Click">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☁️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="txtCloudCardTitle" Text="Bulut API" Foreground="#cdd9e5" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="txtCloudCardDesc" Text="{local:Loc Key=CloudCardDesc}"
                                               Foreground="#8b949e" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="txtCloudCardArrow" Text="{local:Loc Key=ApplyTemplate}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="#58a6ff" FontSize="12"/>
                        </Grid>
                    </Border>

                    <!-- Yerel Model Kartı -->
                    <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,0,0,14" Cursor="Hand"
                            MouseLeftButtonDown="CardLocal_Click">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="txtLocalCardTitle" Text="Yerel Model" Foreground="#cdd9e5" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="txtLocalCardDesc" Text="{local:Loc Key=BilgisayarinizdaCalisanOpenAIUyumluEmbeddingSunucusu}"
                                               Foreground="#8b949e" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="txtLocalCardArrow" Text="{local:Loc Key=ApplyTemplate}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="#3fb950" FontSize="12"/>
                        </Grid>
                    </Border>

                    <!-- API Bilgileri -->
                    <TextBlock x:Name="txtApiInfoTitle" Text="{local:Loc Key=APIBILGILERI}" Foreground="#8b949e"
                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock x:Name="txtBaseUrlLabel" Text="Base URL" Foreground="#8b949e" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtRagBaseUrl" Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>

                    <TextBlock x:Name="txtApiKeyLabel" Text="{local:Loc Key=APIAnahtari}" Foreground="#8b949e" FontSize="12" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="pbRagApiKey" Style="{StaticResource DarkPasswordBox}" Margin="0,0,0,10"/>

                    <TextBlock x:Name="txtModelLabel" Text="{local:Loc Key=ModelAdi}" Foreground="#8b949e" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtRagModel" Style="{StaticResource DarkTextBox}" Margin="0,0,0,4"/>

                    <!-- Ollama kurulum notu -->
                    <Border x:Name="ollamaHint" Background="#0d2016" BorderBrush="#1a4a28"
                            BorderThickness="1" CornerRadius="6" Padding="10,8"
                            Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="txtLocalSetupTitle" Text="{local:Loc Key=LocalSetupAbout}" Foreground="#3fb950"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtLocalSetupBody" TextWrapping="Wrap" Foreground="#8b949e" FontSize="11" LineHeight="18">
                                <Run Text="{local:Loc Key=LocalSetupLine1}"/>
                                <LineBreak/>
                                <Run Text="{local:Loc Key=LocalSetupLine2}"/>
                                <LineBreak/>
                                <Run Text="{local:Loc Key=APIKeyGerektirmeyenSunuculardaBuAlaniBosBirakabilirsiniz}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Alt Butonlar -->
            <Border Grid.Row="2" Background="#161b22" CornerRadius="0,0,12,12"
                    BorderBrush="#30363d" BorderThickness="0,1,0,0" Padding="24,14">
                <Grid>
                    <Button x:Name="btnDisable" Content="{local:Loc Key=DisableRag}"
                            Style="{StaticResource DisableButton}"
                            HorizontalAlignment="Left" Width="200"
                            Click="BtnDisable_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnCancel" Content="{local:Loc Key=Cancel}" Style="{StaticResource CancelButton}"
                                Width="90" Click="BtnClose_Click" Margin="0,0,10,0"/>
                        <Button x:Name="btnSave" Content="✓ Kaydet &amp; Aktif Et"
                                Style="{StaticResource SaveButton}" Width="150"
                                Click="BtnSave_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
