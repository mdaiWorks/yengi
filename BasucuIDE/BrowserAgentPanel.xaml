<UserControl x:Class="mdaiAgent.BrowserAgentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#1e1e1e">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#252526" Padding="8,6" BorderBrush="#3e3e42" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <Border Background="#007acc" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Text="🤖 AI AGENT MODE" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- URL Bar -->
                <Border Grid.Column="1" Background="#1e1e1e" BorderBrush="#3e3e42" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
                    <TextBlock x:Name="tbCurrentUrl" Text="Hazır — Bir komut bekleniyor..."
                               Foreground="#9e9e9e" FontSize="12" Padding="8,5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Border>

                <!-- Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ellStatus" Width="8" Height="8" Fill="#4caf50" Margin="0,0,6,0"/>
                    <TextBlock x:Name="tbStatus" Text="Hazır" Foreground="#9e9e9e" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 -->
        <wv2:WebView2 x:Name="webView" Grid.Row="1"/>

        <!-- Bottom bar -->
        <Border Grid.Row="2" Background="#252526" Padding="8,4" BorderBrush="#3e3e42" BorderThickness="0,1,0,0">
            <TextBlock x:Name="tbActionLog" Text="" Foreground="#7ec8e3"
                       FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
