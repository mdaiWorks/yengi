<Window x:Class="mdaiAgent.ConfirmCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc Key=KomutOnayi}" Height="300" Width="700" WindowStartupLocation="CenterOwner" Background="#1e1e1e" Foreground="#d4d4d4" xmlns:local="clr-namespace:mdaiAgent">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="tbConfirmInstruction" Text="{local:Loc Key=AIAsagidakiKomutuCalistirmakIstiyor}" FontWeight="SemiBold" />
        <Border Grid.Row="1" Margin="0,8,0,8" Background="#252526" BorderBrush="#3c3c3c" BorderThickness="1">
            <ScrollViewer>
                <TextBlock x:Name="tbCommand" TextWrapping="Wrap" Padding="8" FontFamily="Consolas"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnDryRun" Content="{local:Loc Key=KuruCalistir}" Margin="6" Click="BtnDryRun_Click"/>
            <Button x:Name="btnSkip" Content="Skip" Margin="6" Click="BtnSkip_Click"/>
            <Button x:Name="btnAllow" Content="{local:Loc Key=IzinVer}" Margin="6" Background="#4caf50" Foreground="White" Click="BtnAllow_Click"/>
            <Button x:Name="btnCancel" Content="{local:Loc Key=Cancel}" Margin="6" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
