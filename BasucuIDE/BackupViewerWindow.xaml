<Window x:Class="mdaiAgent.BackupViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc Key=YedekGecmisiMdaiAgent}" Height="580" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#0d1117"
        Foreground="#c9d1d9"
        FontFamily="Segoe UI, sans-serif" xmlns:local="clr-namespace:mdaiAgent">
    
    <Window.Resources>
        <!-- Custom Dark ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0d1117"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="#30363d" Margin="2,0,2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium Button Style -->
        <Style TargetType="Button" x:Key="PremiumButton">
            <Setter Property="Background" Value="#21262d"/>
            <Setter Property="Foreground" Value="#c9d1d9"/>
            <Setter Property="BorderBrush" Value="#30363d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363d"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style TargetType="Button" BasedOn="{StaticResource PremiumButton}" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#238636"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#2ea043"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2ea043"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#010409" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="25,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🕒" FontSize="22" Margin="0,0,12,0" Foreground="#58a6ff" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtHeaderTitle" Text="Proje Zaman Makinesi (Yedekler)" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#ffffff"/>
                </StackPanel>
                <Button x:Name="btnRefreshBackups" Content="🔄 Yenile" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnRefreshBackups_Click" Style="{StaticResource PremiumButton}"/>
            </Grid>
        </Border>

        <!-- List -->
        <ListBox x:Name="lstBackups" Grid.Row="1" Margin="25,15,25,0" Background="Transparent" BorderThickness="0"
                 SelectionChanged="LstBackups_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <!-- Kart Tasarımı -->
                                <Border x:Name="Bd" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="8" Padding="15,12">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#21262d"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#8b949e"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1f242c"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#58a6ff"/>
                                        <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- İkon -->
                        <TextBlock Text="📄" FontSize="24" Foreground="#8b949e" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayPath}" FontWeight="Bold" FontSize="14" Foreground="#e6edf3" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding BackupFileName}" FontSize="12" Foreground="#8b949e" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        
                        <!-- Tarih -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                            <TextBlock Text="{Binding BackupDateText}" FontSize="12" Foreground="#58a6ff" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Footer / Actions -->
        <Border Grid.Row="2" Background="#010409" BorderBrush="#30363d" BorderThickness="0,1,0,0" Padding="25,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="tbBackupInfo" Text="{local:Loc Key=HerhangiBirYedekSecilmedi}" VerticalAlignment="Center" Foreground="#8b949e" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnShowInExplorer" Content="{local:Loc Key=GezgindeGoster}" Click="BtnShowInExplorer_Click" IsEnabled="False" Style="{StaticResource PremiumButton}" Margin="0,0,10,0"/>
                    <Button x:Name="btnOpenBackup" Content="{local:Loc Key=DosyayiIncele}" Click="BtnOpenBackup_Click" IsEnabled="False" Style="{StaticResource PremiumButton}" Margin="0,0,10,0"/>
                    <Button x:Name="btnRestoreBackup" Content="{local:Loc Key=BuYedegeDon}" Click="BtnRestoreBackup_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}" Padding="25,8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
