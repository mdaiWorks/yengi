<Window x:Class="mdaiAgent.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc Key=AboutTitle}"
        Width="620" Height="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent" xmlns:local="clr-namespace:mdaiAgent">

    <Window.Resources>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a78bfa"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="tb" Text="{TemplateBinding Content}"
                                   TextDecorations="Underline"
                                   Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tb" Property="Foreground" Value="#c4b5fd"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6b6b8a"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#ff4466"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer shadow border -->
    <Border CornerRadius="16" Background="#0d0d1a"
            BorderBrush="#2a2a45" BorderThickness="1"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>   <!-- gradient accent bar -->
                <RowDefinition Height="Auto"/> <!-- title bar -->
                <RowDefinition Height="*"/>    <!-- content -->
                <RowDefinition Height="Auto"/> <!-- footer -->
            </Grid.RowDefinitions>

            <!-- TOP ACCENT BAR -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#7c6af5" Offset="0"/>
                        <GradientStop Color="#a855f7" Offset="0.4"/>
                        <GradientStop Color="#ec4899" Offset="0.75"/>
                        <GradientStop Color="#f97316" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- TITLE BAR (drag handle) -->
            <Grid Grid.Row="1" Margin="18,12,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Yengi" Foreground="#6b6b8a"
                           FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Opacity="0.7"/>
                <Button Grid.Column="1" Content="✕" Style="{StaticResource CloseButton}"
                        Click="BtnClose_Click"/>
            </Grid>

            <!-- MAIN CONTENT -->
            <StackPanel Grid.Row="2" Margin="32,16,32,0" HorizontalAlignment="Center">

                <!-- LOGO AREA -->
                <Grid HorizontalAlignment="Center" Margin="0,0,0,16">
                    <!-- Glowing background circle -->
                    <Ellipse Width="88" Height="88">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#1a2a5a" Offset="0"/>
                                <GradientStop Color="#0d0d1a" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#4a6af5" BlurRadius="24" ShadowDepth="0" Opacity="0.7"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <!-- Actual App Logo -->
                    <Image Source="logo1.png" Width="60" Height="60"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>

                <!-- APP NAME -->
                <TextBlock Text="Yengi" HorizontalAlignment="Center"
                           FontSize="26" FontWeight="Bold" Foreground="#E8E8E8"
                           FontFamily="Segoe UI">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#7c6af5" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- TAGLINE -->
                <TextBlock x:Name="tbTagline" HorizontalAlignment="Center" Margin="0,4,0,16"
                           FontSize="12" Foreground="#7c7c9a">
                    <Run x:Name="runTagline" Text="{local:Loc Key=AboutTagline}"/>
                </TextBlock>

                <!-- VERSION BADGE + PLATFORM BADGE -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Style="{StaticResource BadgeStyle}" Background="#1a1a3e" BorderBrush="#3a2a7a" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏷️ " FontSize="11"/>
                            <TextBlock x:Name="tbVersion" FontSize="11" Foreground="#a78bfa" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource BadgeStyle}" Background="#0a2a1a" BorderBrush="#0d5a30" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🪟 " FontSize="11"/>
                            <TextBlock Text="Windows · WPF · .NET 8" FontSize="11" Foreground="#4ade80" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- DESCRIPTION -->
                 <TextBlock Text="{local:Loc Key=AboutDescription}" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="#9090b0" FontSize="12.5" LineHeight="20"
                          MaxWidth="400" Margin="0,0,0,16"/>

                <!-- DIVIDER -->
                <Border Height="1" Background="#1e1e3a" Margin="0,0,0,14"/>

                <!-- AUTHOR & CONTACT ROW -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="👨‍💻" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#c4b5fd"/>
                    <TextBlock x:Name="tbDeveloperLabel" Foreground="#7070a0" FontSize="12" VerticalAlignment="Center">
                        <Run x:Name="runDeveloperPrefix" Text="{local:Loc Key=DeveloperPrefix}"/>
                        <Run Text="mdaiWorks" Foreground="#c4b5fd" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="✉️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#c4b5fd"/>
                    <Button x:Name="btnEmail" Content="mdaiyazilim@gmail.com"
                            Style="{StaticResource LinkButton}"
                            Click="BtnEmail_Click"/>
                </StackPanel>

                <!-- GITHUB STAR BUTONU -->
                <Button x:Name="btnGitHubStar" Margin="0,18,0,0" HorizontalAlignment="Center"
                        Click="BtnGitHubStar_Click" Cursor="Hand" Content="GitHub'da Yıldız Ver (Star)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="starBd" CornerRadius="12" Padding="18,10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#f59e0b" Offset="0"/>
                                        <GradientStop Color="#ec4899" Offset="0.5"/>
                                        <GradientStop Color="#8b5cf6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#f59e0b" BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⭐" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}" TextBlock.FontSize="13" TextBlock.FontWeight="Bold" TextBlock.Foreground="White"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="starBd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="starBd" Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- FOOTER -->
            <Border Grid.Row="3" Background="#090914" CornerRadius="0,0,16,16"
                    Padding="24,12" Margin="0,16,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="tbFooterText" Text="{local:Loc Key=AllRightsReserved}"
                                   Foreground="#3a3a5a" FontSize="11"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="btnCheckForUpdates" Content="Güncellemeleri denetle"
                                Margin="16,0,0,0" Style="{StaticResource LinkButton}"
                                Click="BtnCheckForUpdates_Click"/>
                    </StackPanel>
                    <Button x:Name="btnOk" Content="{local:Loc Key=AboutOk}" HorizontalAlignment="Right"
                            Click="BtnClose_Click"
                            Foreground="White" FontWeight="SemiBold"
                            FontSize="12" Padding="20,7" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#7c6af5" Offset="0"/>
                                            <GradientStop Color="#a855f7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
